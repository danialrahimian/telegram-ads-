# Written by `tgads install`. Only bootstrap secrets live here; API tokens, bot keys,
# the Claude key and sync intervals are entered in the dashboard and stored encrypted.
DOMAIN='ads.example.com'
ADMIN_PASSWORD='change-me-please'
SESSION_SECRET='48 random characters'
# Fernet key (32 random bytes, url-safe base64). Losing it makes stored tokens unreadable.
ENCRYPTION_KEY=''
COOKIE_SECURE='1'
COMPOSE_PROFILES='https'
APP_IMAGE='ghcr.io/danialrahimian/telegram-ads:latest'

# Only needed for running from source. On a server, install.sh writes /opt/psychonet-ads/.env for you.

# --- Required ---
TG_ADS_TOKEN=            # Telegram Ads > API > Copy Token
ADMIN_PASSWORD=          # panel password, at least 10 characters
SESSION_SECRET=          # python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Purchase tracking ---
CONVERSIONS_SECRET=      # shared secret your bot sends as "Authorization: Bearer ..."

# 1 when served over HTTPS, 0 for http://localhost (SSH tunnel or local development)
COOKIE_SECURE=0

# --- Optional: analysis from inside the app with the Claude API ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
